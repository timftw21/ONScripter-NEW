pkgname=SDL3
pkgver=3.4.10
pkgrel=3
sources=("https://www.libsdl.org/release/$pkgname-$pkgver.tar.gz"
    'SDL3-metal-upload-stride.patch')
hashes=('12b34280415ec8418c864408b93d008a20a6530687ee613d60bfbd20411f2785'
    '360d013c38daae2fe36054ed0ba52ad391c5f535c6bd7f9220edb205a8d65677')

prebuild() {
    pushd "$pkgname-$pkgver" &>/dev/null
    # Metal must honor padded transfer rows, as the other GPU backends do.
    apply_patch "${sources[1]}"
}

cflags="-O3"

cmakeopts=(
    '-DCMAKE_BUILD_TYPE=Release'
    '-DCMAKE_INSTALL_LIBDIR=lib'
    '-DSDL_SHARED=OFF'
    '-DSDL_STATIC=ON'
    '-DSDL_TEST_LIBRARY=OFF'
    '-DSDL_TESTS=OFF'
    '-DSDL_INSTALL_TESTS=OFF'
    '-DSDL_EXAMPLES=OFF'
    '-DSDL_INSTALL=ON'
    '-DSDL_INSTALL_DOCS=OFF'
    '-DSDL_INSTALL_CPACK=OFF'
    '-DSDL_DEPS_SHARED=OFF'
    '-DSDL_GPU=ON'
    '-DSDL_RENDER=ON'
    '-DSDL_RENDER_GPU=ON'
)

cmake_command() {
    if command -v cmake >/dev/null 2>&1; then
        echo cmake
        return
    fi
    if [ -x "/c/Program Files/CMake/bin/cmake.exe" ]; then
        echo "/c/Program Files/CMake/bin/cmake.exe"
        return
    fi
    error_out "cmake is required to build %s" "$pkgname"
}

cmake_generator() {
    if command -v ninja >/dev/null 2>&1; then
        echo Ninja
    elif [ "$(getHost)" == "win32" ]; then
        echo "MSYS Makefiles"
    else
        echo "Unix Makefiles"
    fi
}

configure() {
    msg "Running cmake"

    local ret=0
    local logfile="$logdir/$pkgname.cmake.log"
    local lcf="$CFLAGS ${cflags[@]} $CFLAGS_EXTRA"
    local lcxf="$CPPFLAGS ${cppflags[@]} ${cflags[@]} $CPPFLAGS_EXTRA $CFLAGS_EXTRA"
    local llf="$LDFLAGS ${ldflags[@]} $LDFLAGS_EXTRA"
    local cmake_outdir="$outdir"

    rm -rf build

    # SDL3 uses floating-point environment pragmas in audio conversion code.
    # The global fast-math flag makes those pragmas invalid under Clang.
    lcf="${lcf//-ffast-math/}"
    lcxf="${lcxf//-ffast-math/}"

    if [ "$(getHost)" == "win32" ]; then
        cmake_outdir="$(cygpath -m "$outdir")"
        lcf="${lcf//$outdir/$cmake_outdir}"
        lcxf="${lcxf//$outdir/$cmake_outdir}"
        llf="${llf//$outdir/$cmake_outdir}"
    fi

    local cmake_cmd="$(cmake_command)"
    local generator="$(cmake_generator)"
    local cmake_cc="$(getCC)"
    local cmake_cxx="$(getCXX)"
    [ "$CMAKE_CC" != "" ] && cmake_cc="$CMAKE_CC"
    [ "$CMAKE_CXX" != "" ] && cmake_cxx="$CMAKE_CXX"
    local cmake_compiler_opts=()
    if [ "$(getTarget)" != "droid" ]; then
        cmake_compiler_opts+=("-DCMAKE_C_COMPILER=$cmake_cc")
        [ "$cmake_cxx" != "" ] && cmake_compiler_opts+=("-DCMAKE_CXX_COMPILER=$cmake_cxx")
    fi
    local cmake_tool_opts=()
    [ "${CMAKE_AR:-$AR}" != "" ] && cmake_tool_opts+=("-DCMAKE_AR=${CMAKE_AR:-$AR}")
    [ "${CMAKE_RANLIB:-$RANLIB}" != "" ] && cmake_tool_opts+=("-DCMAKE_RANLIB=${CMAKE_RANLIB:-$RANLIB}")
    [ "${CMAKE_STRIP:-$STRIP}" != "" ] && cmake_tool_opts+=("-DCMAKE_STRIP=${CMAKE_STRIP:-$STRIP}")
    [ "${CMAKE_NM:-$NM}" != "" ] && cmake_tool_opts+=("-DCMAKE_NM=${CMAKE_NM:-$NM}")
    [ "${CMAKE_OBJCOPY:-$OBJCOPY}" != "" ] && cmake_tool_opts+=("-DCMAKE_OBJCOPY=${CMAKE_OBJCOPY:-$OBJCOPY}")
    [ "${CMAKE_OBJDUMP:-$OBJDUMP}" != "" ] && cmake_tool_opts+=("-DCMAKE_OBJDUMP=${CMAKE_OBJDUMP:-$OBJDUMP}")
    if [ "$(getTarget)" == "droid" ]; then
        # The NDK toolchain file sets compilers, sysroot, triple, STL and binutils.
        # Assign rather than append so the host tool overrides above are dropped.
        cmake_tool_opts=(
            "-DCMAKE_TOOLCHAIN_FILE=$ANDROID_NDK_ROOT_CMAKE/build/cmake/android.toolchain.cmake"
            "-DANDROID_ABI=$ANDROID_ABI"
            "-DANDROID_PLATFORM=android-${ANDROID_API:-34}"
            "-DANDROID_STL=c++_static"
        )
    fi

    "$cmake_cmd" -S . -B build -G "$generator" \
        -DCMAKE_INSTALL_PREFIX="$cmake_outdir" \
        -DCMAKE_PREFIX_PATH="$cmake_outdir" \
        "${cmake_compiler_opts[@]}" \
        -DCMAKE_C_FLAGS="$lcf" \
        -DCMAKE_CXX_FLAGS="$lcxf" \
        -DCMAKE_EXE_LINKER_FLAGS="$llf" \
        "${cmake_tool_opts[@]}" \
        "${cmakeopts[@]}" &>"$logfile" || ret=$?

    if (( ret )); then
        tail -n 20 "$logfile"
        error "CMake setup %s failed" "$pkgname"
        error "The full log is: %s" "$logfile"
        exit 1
    fi
}

compile() {
    local logfile="$logdir/$pkgname.build.log"
    local ret=0
    if [ -f build/build.ninja ]; then
        ninja -C build &>"$logfile" || ret=$?
    else
        make -C build $MAKEOPTS &>"$logfile" || ret=$?
    fi
    if (( ret )); then
        tail -n 20 "$logfile"
        error "Compiling %s failed" "$pkgname"
        error "The full log is: %s" "$logfile"
        exit 1
    fi
}

copy() {
    local logfile="$logdir/$pkgname.install.log"
    local ret=0
    local cmake_cmd="$(cmake_command)"
    "$cmake_cmd" --install build &>"$logfile" || ret=$?
    if (( ret )); then
        tail -n 20 "$logfile"
        error "Installing %s failed" "$pkgname"
        error "The full log is: %s" "$logfile"
        exit 1
    fi
}

# Official SDL archives contain symlinks that are not always creatable in
# Windows/MSYS2 worktrees. They are not required by this dependency build.
extract_sources() {
    msg "Extracting sources"
    pushd $srcdir &>/dev/null

    local netfile
    for netfile in "${sources[@]}"; do
        local file=$(get_filename "$netfile")
        if in_array "$file" "${noextract[@]}"; then
            continue
        fi

        local filetype=$(file -bzL --mime "$file")
        local ext=${file##*.}
        local cmd=''

        case "$filetype" in
            *application/x-tar*) cmd='tar -xf' ;;
            *application/x-zip*|*application/zip*) cmd='unzip -q' ;;
            *)
                case "$ext" in
                    bz2|gz|tar|xz) cmd='tar -xf' ;;
                    zip) cmd='unzip -q' ;;
                    *) continue ;;
                esac
                ;;
        esac

        local ret=0
        msg2 "Extracting %s with %s" "$file" "$cmd"
        $cmd "$file" || ret=$?

        if (( ret )); then
            warn "Errors while extracting %s; plowing ahead" "$file"
        fi
    done

    popd &>/dev/null
}

# vim: set syntax=sh:

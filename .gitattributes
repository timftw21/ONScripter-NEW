*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary

*.ttf binary
*.otf binary

*.dll binary
*.exe binary
*.lib binary
*.pdb binary

*.apk binary
*.ipa binary
*.zip binary
*.7z binary
*.gz binary
*.tar binary

*.mp3 binary
*.ogg binary
*.wav binary
*.flac binary
*.mp4 binary
*.webm binary

*.nsa binary
*.ns2 binary
*.sar binary

# Shell scripts and the build driver must keep LF endings; MSYS/Android build
# hosts cannot execute a CRLF shebang ("bad interpreter: /bin/bash^M").
configure text eol=lf
gradlew text eol=lf
*.sh text eol=lf
*.tool text eol=lf
*.pkgbuild text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Patch context must retain the original script's whitespace.
Resources/GamePatches/*.patch text eol=lf -whitespace

# Dependency recipes hash patches with LF line endings; preserve patch context.
Dependencies/patches/*.patch text eol=lf -whitespace
